    <PackageReference Include="Umbraco.Cms.Persistence.Sqlite" Version="17.7.1" />
    <PackageReference Include="Umbraco.Cms.Persistence.EFCore.Sqlite" Version="17.7.1" />
    <PackageReference Include="Umbraco.Cms.Targets" Version="17.7.1" />
    <Content Remove="appsettings.json;umbraco/**/*;wwwroot/**/*;appsettings-schema*.json;umbraco-package-schema.json" />
