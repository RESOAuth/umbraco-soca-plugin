<Project>
  <ItemGroup>
    <Content Include="$(MSBuildThisFileDirectory)../content/Soca/**/*">
      <Link>wwwroot/App_Plugins/Soca/%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>
</Project>
