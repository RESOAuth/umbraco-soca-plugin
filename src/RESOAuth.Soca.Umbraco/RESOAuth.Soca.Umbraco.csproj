<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PackageId>RESOAuth.Soca.Umbraco</PackageId>
    <Version>0.1.0-alpha.1</Version>
    <Authors>RESOAuth</Authors>
    <Description>SOCA OIDC and CIMD login providers for Umbraco backoffice users and members.</Description>
    <PackageLicenseExpression>AGPL-3.0-only</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/RESOAuth/umbraco-soca-plugin</RepositoryUrl>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Umbraco.Cms.Api.Management" Version="17.7.1" />
    <PackageReference Include="Umbraco.Cms.Web.Website" Version="17.7.1" />
    <PackageReference Include="MessagePack" Version="3.1.12" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.13" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.13" />
    <Content Include="wwwroot/App_Plugins/Soca/**/*" Pack="true" PackagePath="content/Soca/%(RecursiveDir)%(Filename)%(Extension)" />
    <None Include="../../README.md" Pack="true" PackagePath="README.md" />
    <None Include="buildTransitive/RESOAuth.Soca.Umbraco.targets" Pack="true" PackagePath="buildTransitive/RESOAuth.Soca.Umbraco.targets" />
  </ItemGroup>
</Project>
